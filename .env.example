# TOLSTOY — environment template
# Copy to .env and adjust. Never commit .env (it is gitignored).

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Storage
DATABASE_PATH=database/tolstoy.db

# Google Gemini (required for script generation)
GEMINI_API_KEY=
GEMINI_MODEL=

# Contact-form email (leave blank to disable sending)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ADMIN_EMAIL=

# Bootstrap accounts — created on first run only if absent.
# Demo credentials for local development: change these before production.
SUPER_ADMIN_USERNAME=Pawan Simha R
SUPER_ADMIN_PASSWORD=iamsuperadmin
ADMIN_USERNAME=Ramesh
ADMIN_PASSWORD=iamadmin
ADMIN2_USERNAME=Suresh
ADMIN2_PASSWORD=iamadmin
